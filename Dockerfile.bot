FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgobject-2.0-0 \
    libnspr4 \
    libnss3 \
    libdbus-1-3 \
    libgio-2.0-0 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libexpat1 \
    libxcb1 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libcairo2 \
    libpango-1.0-0 \
    libasound2 \
    fonts-liberation \
    xvfb \
    xauth \
    tini \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install chromium
RUN patchright install chrome

COPY src ./src
COPY bot ./bot
COPY config ./config
COPY scripts ./scripts
COPY alembic.ini .
COPY alembic ./alembic

# WB's antibot challenge stalls forever under headless Chromium (any mode) but
# resolves in a couple of seconds under a real headed session; Ozon's
# patchright/Chrome session also runs headed (its own stealth recommendation)
# — xvfb-run gives both a virtual display so they can run headed without a
# physical monitor.
#
# tini as PID 1 is required, not cosmetic: xvfb-run's internal `wait` for
# Xvfb's readiness signal relies on real signal delivery, which the kernel
# handles differently for PID 1 than for any other process — without a proper
# init in front of it, xvfb-run hangs forever before ever launching Python.
ENTRYPOINT ["tini", "--"]
CMD ["xvfb-run", "-a", "python", "-m", "bot.main"]
