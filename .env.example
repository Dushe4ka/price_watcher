DB_DIALECT=postgresql
DB_DRIVER=asyncpg
DB_USERNAME=replace_with_db_username
DB_PASSWORD=replace_with_db_password
DB_NAME=price_watcher
DB_HOST=db
DB_PORT=5432
SECRET=replace_with_application_secret
TITLE=Price Watcher
DESCRIPTION=Сервис для мониторинга цен.
FIRST_SUPERUSER_EMAIL=admin@example.invalid
FIRST_SUPERUSER_PASSWORD=replace_with_superuser_password
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
POSTGRES_USER=replace_with_postgres_user
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=price_watcher
POSTGRES_PORT=5432
POSTGRES_HOST=db
API_CONTAINER=api
API_PORT=8000
PROTOCOL=http

# Deal Channel Bot
MIN_DISCOUNT_PERCENT=15
MIN_PARSER_DISCOUNT_PERCENT=15
MIN_DATABASE_DISCOUNT_PERCENT=20
PRICE_HISTORY_RETENTION_DAYS=90
DATA_COLLECTION_WARMUP_DAYS=0
ADMIN_TELEGRAM_ID=
# Несколько админов через запятую: 123456789,987654321
MARKET_CHECK_MIN_PRICE=10000
MARKET_CHECK_DISCOUNT_PERCENT=10
MARKET_CHECK_CATEGORIES=electronics,furniture,home
CRAWL_INTERVAL_MINUTES=30
DEALS_ENABLED=true
MAX_PRODUCTS_PER_CATEGORY=20
MIN_PRODUCT_RATING=4.5
REQUIRE_RATING=true
OZON_ENABLED=true
# Prod: true + PROXY_LIST with RU residential / mobile proxies (antibot).
OZON_PROXY_REQUIRED=false
OZON_BROWSER_IDLE_SEC=600
OZON_REQUEST_DELAY_SEC=0.5
OZON_CHALLENGE_TIMEOUT_SEC=20
OZON_FETCH_RETRIES=3
OZON_MAX_CONSECUTIVE_BLOCKS=3
OZON_BLOCK_COOLDOWN_SEC=120
# Persistent patchright/Chrome profile dir — mount as a volume in prod so it
# "ages" across restarts instead of resetting to a fresh throwaway profile.
OZON_PROFILE_DIR=.ozon-profile
# WB now needs a headed (real, non-headless) Chromium session to pass its
# antibot challenge — see Dockerfile.bot (xvfb-run). Proxy is optional; the
# challenge itself isn't IP-reputation gated, only headless-detection gated.
WB_PROXY_REQUIRED=false
WB_BROWSER_IDLE_SEC=600
WB_REQUEST_DELAY_SEC=1.0
WB_CHALLENGE_TIMEOUT_SEC=20
WB_FETCH_RETRIES=3
WB_MAX_CONSECUTIVE_BLOCKS=3
WB_BLOCK_COOLDOWN_SEC=120
# Comma-separated. Prefer RU residential/mobile. Do not commit real proxies.
# Chromium can't do authenticated SOCKS5 — use unauthenticated (IP-whitelisted)
# SOCKS5 or HTTP(S) with auth. For a phone-tunnel SOCKS5 bound to the VPS
# host's loopback, the bot container reaches it via host.docker.internal
# (requires the `extra_hosts: host-gateway` entry on the bot service).
PROXY_LIST=socks5://host.docker.internal:1080
CATEGORIES_CONFIG_PATH=config/monitored_categories.yaml

# Marketplace source policy. Sources remain in these ordered chains even when
# their optional credentials are not configured; unavailable sources report
# "disabled" and the next source can be attempted.
MARKETPLACE_RUNTIME_ROLE=local
BROWSER_PROFILE_ROOT=browser-profiles
WILDBERRIES_SOURCE_CHAIN=browser,apify
OZON_SOURCE_CHAIN=browser,apify
YANDEX_MARKET_SOURCE_CHAIN=public,browser,apify

# Optional Apify fallback. Keep all values empty in local/test environments.
APIFY_TOKEN=
APIFY_WILDBERRIES_CRAWL_CATEGORY_ACTOR_ID=
APIFY_WILDBERRIES_PARSE_PRODUCT_ACTOR_ID=
APIFY_WILDBERRIES_SEARCH_PRODUCTS_ACTOR_ID=
APIFY_OZON_CRAWL_CATEGORY_ACTOR_ID=
APIFY_OZON_PARSE_PRODUCT_ACTOR_ID=
APIFY_OZON_SEARCH_PRODUCTS_ACTOR_ID=
APIFY_YANDEX_MARKET_CRAWL_CATEGORY_ACTOR_ID=
APIFY_YANDEX_MARKET_PARSE_PRODUCT_ACTOR_ID=
APIFY_YANDEX_MARKET_SEARCH_PRODUCTS_ACTOR_ID=

# CAPTCHA handling is opt-in. Only deterministic frictionless SmartCaptcha
# flows with a preconfigured public widget ID are supported. Interactive
# challenges and pages without a trusted widget ID fail closed.
CAPTCHA_ADAPTER_MODE=disabled
OHMYCAPTCHA_API_KEY=
SMARTCAPTCHA_MODE=disabled
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_WIDGET_ID=

# Shared bounds for every marketplace operation and its source-local retry.
MARKETPLACE_TOTAL_TIMEOUT_SEC=30
MARKETPLACE_MAX_CONTENT_BYTES=2000000
MARKETPLACE_RETRY_MAX_ATTEMPTS=2
MARKETPLACE_RETRY_BASE_DELAY_MS=250
MARKETPLACE_RETRY_MAX_DELAY_MS=1000
