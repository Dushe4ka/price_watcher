# Deal Channel Bot
MIN_DISCOUNT_PERCENT=15
MIN_PARSER_DISCOUNT_PERCENT=15
MIN_DATABASE_DISCOUNT_PERCENT=20
PRICE_HISTORY_RETENTION_DAYS=90
DATA_COLLECTION_WARMUP_DAYS=0
ADMIN_TELEGRAM_ID=790067446
# Несколько админов через запятую: 790067446,123456789
MARKET_CHECK_MIN_PRICE=10000
MARKET_CHECK_DISCOUNT_PERCENT=10
MARKET_CHECK_CATEGORIES=electronics,furniture,home
CRAWL_INTERVAL_MINUTES=30
DEALS_ENABLED=true
MAX_PRODUCTS_PER_CATEGORY=20
MIN_PRODUCT_RATING=4.5
REQUIRE_RATING=true
OZON_ENABLED=true
# Prod: true + PROXY_LIST with RU residential / mobile proxies (antibot).
OZON_PROXY_REQUIRED=false
OZON_BROWSER_IDLE_SEC=600
OZON_REQUEST_DELAY_SEC=0.5
OZON_CHALLENGE_TIMEOUT_SEC=20
OZON_FETCH_RETRIES=3
OZON_MAX_CONSECUTIVE_BLOCKS=3
OZON_BLOCK_COOLDOWN_SEC=120
# Persistent patchright/Chrome profile dir — mount as a volume in prod so it
# "ages" across restarts instead of resetting to a fresh throwaway profile.
OZON_PROFILE_DIR=.ozon-profile
# WB now needs a headed (real, non-headless) Chromium session to pass its
# antibot challenge — see Dockerfile.bot (xvfb-run). Proxy is optional; the
# challenge itself isn't IP-reputation gated, only headless-detection gated.
WB_PROXY_REQUIRED=false
WB_BROWSER_IDLE_SEC=600
WB_REQUEST_DELAY_SEC=1.0
WB_CHALLENGE_TIMEOUT_SEC=20
WB_FETCH_RETRIES=3
WB_MAX_CONSECUTIVE_BLOCKS=3
WB_BLOCK_COOLDOWN_SEC=120
# Comma-separated. Prefer RU residential/mobile. Do not commit real proxies.
PROXY_LIST=socks5://user:password@host:1080
CATEGORIES_CONFIG_PATH=config/monitored_categories.yaml